    freq: bool = False,
    counts: bool = False,
    depth: bool = False,
    site_depth: bool = False,
    site_mean_depth: bool = False,
    geno_depth: bool = False,
    site_quality: bool = False,
    missing_site: bool = False,
    missing_indv: bool = False,
    het: bool = False,
    hardy: bool = False,
    singletons: bool = False,
    filter_summary: bool = False,
    FILTER_summary: bool = False,
    tstv_summary: bool = False,
    TsTv_summary: bool = False,
    indel_hist: bool = False,
    hist_indel_len: bool = False,
    snp_density: str | int | float | os.PathLike[str] | None = None,
    SNPdensity: str | int | float | os.PathLike[str] | None = None,
    summary: bool = False,
    json: bool = False,
    vcf_span: Literal["allele", "ref"] | None = None,
