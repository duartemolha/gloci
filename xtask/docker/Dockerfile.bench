# Benchmark container for gloci: baselines and yardsticks (pinned).
FROM mambaorg/micromamba:1.5.10

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

USER mambauser

# Baselines and conda-available yardsticks (pinned)
RUN micromamba install -y -n base -c conda-forge -c bioconda \
        rust=1.99.1 \
        bedtools=2.31.1 \
        bedops=2.4.41 \
        vcftools=0.1.16 \
        htslib=1.21 \
        bcftools=1.21 \
        samtools=1.21 \
        mosdepth=0.3.10 \
        hyperfine=2.0.0 \
        bedtk=1.1 \
        coreutils=9.12 \
        gawk=5.3.1 \
        ucsc-bigwigtobedgraph=469 \
    && micromamba clean --all --yes

# vcfkit (yardstick for `vcf filter`): its own step, because every conda build
# requires networkx 1.11, which no longer exists (the solver fails). A failure
# is reported here and the bench runner then skips the yardstick.
RUN micromamba install -y -n base -c conda-forge -c bioconda vcfkit=0.2.8 \
    && micromamba clean --all --yes \
    || echo "skipped: vcfkit not installed (micromamba install vcfkit=0.2.8 failed); its benchmark columns will be empty"

# plink2 (yardstick for `vcf stats`): its own step, because the bioconda
# package is not built for every architecture. A failure is reported here and
# the bench runner then skips the yardstick. The version is unverified on
# aarch64: check the build log for "skipped: plink2".
RUN micromamba install -y -n base -c conda-forge -c bioconda plink2=2.0.0a.6.9 \
    && micromamba clean --all --yes \
    || echo "skipped: plink2 not installed (micromamba install plink2=2.0.0a.6.9 failed); its benchmark columns will be empty"

# Python 3.12 for the Python library benchmarks (D96): its own step, so a solver
# conflict with the tools above cannot take them down. The bench runner skips the
# Python cases' tools when `python3` cannot import them.
# pip has a floor: on x86_64 a step above brings Python 3.6 with pip 21.3.1, and
# the solver kept that pip when it moved Python to 3.12, where it cannot start
# (`pkgutil.ImpImporter` is gone). Every `pip install` below was then skipped and
# the runner's install of the gloci wheel failed, which stopped the nightly
# benchmark job before its first case. The step runs pip once so that a pip that
# cannot start shows here.
RUN micromamba install -y -n base -c conda-forge python=3.12 'pip>=24' \
    && micromamba run -n base python -m pip --version \
    && micromamba clean --all --yes \
    || echo "skipped: python not installed (micromamba install python=3.12 failed); the Python benchmark columns will be empty"

COPY --chown=mambauser:mambauser py-bench-constraints.txt /tmp/py-bench-constraints.txt

# The Python libraries: pybedtools is the binding baseline of gloci-py, the others
# are yardsticks. Their dependencies are fixed by py-bench-constraints.txt. Each is its own step: a
# package with no build for this architecture is reported here and skipped.
# (`micromamba run`: RUN steps do not activate the base environment.)
RUN micromamba run -n base python -m pip install --no-cache-dir -c /tmp/py-bench-constraints.txt pybedtools==0.12.1 \
    || echo "skipped: pybedtools not installed (pip install pybedtools==0.12.1 failed); its benchmark columns will be empty"
RUN micromamba run -n base python -m pip install --no-cache-dir -c /tmp/py-bench-constraints.txt polars-bio==0.37.0 \
    || echo "skipped: polars-bio not installed (pip install polars-bio==0.37.0 failed); its benchmark columns will be empty"
RUN micromamba run -n base python -m pip install --no-cache-dir -c /tmp/py-bench-constraints.txt pyranges1==1.5.1 \
    || echo "skipped: pyranges1 not installed (pip install pyranges1==1.5.1 failed); its benchmark columns will be empty"
RUN micromamba run -n base python -m pip install --no-cache-dir -c /tmp/py-bench-constraints.txt bioframe==0.8.0 \
    || echo "skipped: bioframe not installed (pip install bioframe==0.8.0 failed); its benchmark columns will be empty"

USER root
# GNU time for peak RSS (D96). Debian's, not conda-forge's: its `time` 1.9
# build reports 0 for %M on aarch64.
RUN apt-get update && apt-get install -y --no-install-recommends \
        time=1.9-0.2 \
    && rm -rf /var/lib/apt/lists/*

# Install yardsticks from cargo / git with pinned versions and commits
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"

# Each install that fails is reported as "skipped: ... not installed" in the
# build log; the bench runner then skips that yardstick.

# gia (genomic interval arithmetic): pinned 0.2.0
RUN cargo install --version 0.2.0 gia \
    || echo "skipped: gia not installed (cargo install --version 0.2.0 gia failed); its benchmark columns will be empty"

# granges: pinned 0.2.0
RUN cargo install --version 0.2.0 granges \
    || echo "skipped: granges not installed (cargo install --version 0.2.0 granges failed); its benchmark columns will be empty"

# grit-genomics: pinned 0.1.0
RUN cargo install --version 0.1.0 grit-genomics \
    || echo "skipped: grit-genomics not installed (cargo install --version 0.1.0 grit-genomics failed); its benchmark columns will be empty"

# bedder: pinned commit
RUN cargo install --git https://github.com/brentp/bedder --rev 4cf2ef6 bedder \
    || echo "skipped: bedder not installed (cargo install --git https://github.com/brentp/bedder --rev 4cf2ef6 bedder failed); its benchmark columns will be empty"

# vcfexpress: pinned commit
RUN cargo install --git https://github.com/vcfexpress/vcfexpress --rev 3a893cb vcfexpress \
    || echo "skipped: vcfexpress not installed (cargo install --git https://github.com/vcfexpress/vcfexpress --rev 3a893cb vcfexpress failed); its benchmark columns will be empty"

USER mambauser
WORKDIR /
